FROM ubuntu:24.04

ARG LATEST_TAG
ARG BETA_TAG

ENV XPRA_UBUNTU_RELEASE="noble"
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /tmp

# Install xpra and desktop environment
RUN set -eux \
    && apt-get update \
    && apt-get install -y \
        ca-certificates \
        apt-transport-https \
        software-properties-common \
        curl \
        wget \
        jq \
        cron \
        gosu \
        python3 \
        python3-requests \
    && add-apt-repository universe \
    && curl -o /usr/share/keyrings/xpra.asc https://xpra.org/xpra.asc \
    && curl -o /etc/apt/sources.list.d/xpra.sources https://raw.githubusercontent.com/Xpra-org/xpra/master/packaging/repos/${XPRA_UBUNTU_RELEASE}/xpra.sources \
    && apt-get update \
    && apt-get install -y \
        xpra \
        openjdk-17-jre \
        zenity \
        xdg-utils \
        trash-cli \
        desktop-file-utils \
        nautilus \
        gedit \
        gnome-terminal \
        libasound2t64 \
        libavcodec-extra \
        libavformat-extra \
        libgdk-pixbuf2.0-0 \
        libgl1 \
        libgtk-3-0t64 \
        libgtk2.0-0t64 \
        libxtst6 \
        ubuntu-wallpapers-noble \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install IPTVBoss
RUN CPU=$(dpkg --print-architecture) \
    && if [ -n "$LATEST_TAG" ]; then \
        wget -q "https://github.com/walrusone/iptvboss-release/releases/download/${LATEST_TAG}/iptvboss_${LATEST_TAG#v}_${CPU}.deb" && \
        apt-get update && apt-get install -y "./iptvboss_${LATEST_TAG#v}_${CPU}.deb" && \
        rm -f "iptvboss_${LATEST_TAG#v}_${CPU}.deb"; \
    fi \
    && if [ -n "$BETA_TAG" ]; then \
        wget -q "https://github.com/walrusone/iptvboss-beta/releases/download/${BETA_TAG#v}/iptvboss_${BETA_TAG#v}_${CPU}.deb" && \
        apt-get update && apt-get install -y "./iptvboss_${BETA_TAG#v}_${CPU}.deb" && \
        rm -f "iptvboss_${BETA_TAG#v}_${CPU}.deb"; \
    fi \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Setup Xpra environment and desktop
RUN set -eux \
    && rm -rvf /usr/share/xpra/www/default-settings.* \
    && mkdir -m 777 -p /tmp/xdg/xpra /run/xpra /etc/xdg/menus \
    && chmod 777 /run/user /run/xpra \
    && echo "<Menu/>" > /etc/xdg/menus/kde-debian-menu.menu \
    && echo "<Menu/>" > /etc/xdg/menus/debian-menu.menu \
    && find /usr/share/applications -not -name '*iptvboss*' -not -name '*Terminal*' -not -name '*Nautilus*' -not -name '*gedit*' -type f -delete \
    && update-desktop-database

# Create app user
RUN useradd -m -s /bin/bash app

# Shared cron helper scripts (also used by Dockerfile / Dockerfile.headless)
COPY configure_cron_schedule.sh /usr/local/bin/configure_cron_schedule.sh
COPY cronitor.py /usr/local/bin/cronitor.py
RUN chmod +x /usr/local/bin/configure_cron_schedule.sh /usr/local/bin/cronitor.py
RUN mkdir -m 700 -p /config/log && chown -R app:app /config

# Point the shared cron script at /config instead of its /headless defaults
ENV CRON_FILE="/config/iptvboss-cron"
ENV CRON_TARGET_CMD="/usr/lib/iptvboss/bin/iptvboss -nogui >> /config/log/cron.log 2>&1"

COPY xpra-entrypoint.sh /opt/xpra-entrypoint.sh
RUN chmod +x /opt/xpra-entrypoint.sh

# Expose Xpra port
ENV XPRA_BIND="0.0.0.0"
ENV XPRA_PORT="5454"
ENV XPRA_AUTH="none"
EXPOSE $XPRA_PORT

VOLUME ["/config"]

ENTRYPOINT ["/opt/xpra-entrypoint.sh"]
